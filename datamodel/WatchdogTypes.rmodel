#include "CommonTypes.rmodel"


/**
 * Types used by the watchdog service and client.
 */
module M_Watchdog
{
  /**
   * Contains watchdog settings.
   */
  struct WatchdogSettingsType
  {
    /// List of operations that can be watched.
    /// Note: If empty, all available operations are watchable.
    M_Common::StringListType WatchableOperations;
  };


  /**
   * Contains watch status.
   */
  struct WatchStatusType
  {
    /// List of operations being watched.
    /// Note: If empty, all watchable operations are being watched.
    M_Common::StringListType WatchedOperations;
  };
};