#include "CommonTypes.rmodel"


/**
 * Types used by the language manager service and client.
 */
module M_LanguageManager
{
  /// Identifies a language.
  typedef string LanguageType;

  /// List of LanguageType.
  typedef sequence<LanguageType> LanguageListType;


  /**
   * Contains text in a specified language.
   */
  struct TextType
  {
    /// Language of the text.
    LanguageType Language;

    /// Text.
    string Text;
  };

  /// List of TextType.
  typedef sequence<TextType> TextListType;


  /**
   * Contains the settings of the language manager.
   */
  struct LanguageManagerSettingsType
  {
    /// Default language in the system.
    LanguageType DefaultLanguage;

    /// Languages that the system supports.
    LanguageListType SupportedLanguages;
  };


  /**
   * Contains the status of the language manager.
   */
  struct LanguageManagerStatusType
  {
    /// Currently selected language.
    LanguageType SelectedLanguage;
  };
};