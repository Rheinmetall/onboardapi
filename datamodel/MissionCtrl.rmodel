#include "MissionCtrlTypes.rmodel"


/**
 * Interfaces used by the mission control service and client.
 */
module M_MissionCtrl
{
  /// Interface version number.
  const string Version = "4.2.0";


  /**
   * Mission control service interface.
   * Contains operations that a client can command the mission control service to perform.
   */
  interface IService
  {
    /**
     * Perform a specified action.
     */
    void CmdPerformAction
    (
      /// Action to perform.
      in CommandedActionType Action
    );

    /**
     * Perform a specified mission.
     */
    void CmdPerformMission
    (
      /// Identifies the mission.
      in string Name,

      /// Mission to perform.
      in MissionOptionalType Mission
    );

    /**
     * Abort a specified mission.
     */
    void CmdAbortMission
    (
      /// Identifies the mission.
      in string Name
    );

    /**
     * Store a specified mission.
     */
    void ConfigStoreMission
    (
      /// Identifies the mission to be loaded.
      /// Note: Empty key should indicate to unload an existing mission.
      in string KeyName,

      /// The mission to be loaded.
      in MissionType Mission,

      /// Indicates if the payload is no longer available
      /// Note: This will always be set to true when the instance has been shut down
      /// After this has been set to true, the payload will no longer be available to late joiners.
      in boolean IsRemoved
    );

    /**
     * Delete a specified mission.
     */
    void CmdDeleteMission
    (
      /// Identifies the mission.
      in string Name
    );
  };


  /**
   * Mission control client interface.
   * Contains callback operations from the mission control service to a client.
   */
  interface IClient
  {
    /**
     * Report the static settings of the mission control service.
     */
    void ReportMissionCtrlSettings
    (
      /// Settings of the mission control service.
      in MissionCtrlSettingsType MissionCtrlSettings
    );

    /**
     * Report the current status of the specified mission.
     */
    void ReportMissionStatus
    (
      /// Current status of the specified mission.
      in MissionStatusType MissionStatus,

      /// Indicates if the status is no longer available.
      /// Note: This will always be set to true when a service has been shut down.
      /// After this has been set to true, the status will no longer be available to late joiners.
      in boolean IsRemoved
    );

    /**
     * Report the current status of the specified mission.
     */
    void ReportStoredMission
    (
      /// Identifies the mission or action.
      in string KeyName,

      /// Current status of the specified mission.
      in MissionType Mission,

      /// Indicates if the status is no longer available.
      /// Note: This will always be set to true when a service has been shut down.
      /// After this has been set to true, the status will no longer be available to late joiners.
      in boolean IsRemoved
    );

    /**
     * Report a map (partition).
     */
    void ReportMap
    (
      /// Multi-level surface map.
      in MultiLevelSurfaceMapType MlsMap
    );
  };
};
