#include "GenericInputOutputTypes.rmodel"

/**
 * A generic input output service represents any IO interface. It can be used
 * to report any information about the IO interface.
 */
module M_GenericInputOutput
{
  /// Interface version number
  const string Version = "1.3.0";

  /**
   * GenericInputOutput service interface
   * Contains operations that a client can command the generic IO service to perform.
   */
  interface IService
  {
    /**
     * Configure the interface properties
     */
    void ConfigInterfaceProperties
    (
      /// The source of the configuration
      in string KeySource,

      /// The configuration to be applied
      in InputOutputConfiguration Config,

      /// Indicates if the configuration shall be removed
      in boolean IsRemoved
    );

    /**
     * Commands to read binary data
     * Note: The service will perform a read operation on the I/O device and will
     * provide the read data in the `EventDataReceived` operation to the client.
     */
    void CmdRead();

    /**
     * Commands to write binary data to the interface
     */
    void CmdWriteData
    (
      /// Binary data to write to the interface
      in InputOutputData Data
    );

    /**
     * Commands to read a speicified register
     */
    void CmdReadRegister
    (
      /// Identifier of the register
      in string KeyId
    );

    /**
     * Command to write to a specified register
     */
    void CmdWriteRegister
    (
      /// Identifier of the register
      in string KeyId,

      /// Value to write
      in M_Common::PropertyType Value
    );

    /**
     * Command to stop writing
     */
    void CmdStopWriting();
  };

  /**
   * GenericInputOutput client interface
   * Contains callback operation from the generic input/output service to the client
   */
  interface IClient
  {
    /**
     * Report of generic I/O interface settings
     */
    void ReportInputOutputSettings
    (
      /// Active settings of the I/O interface
      in InputOutputSettings Settings
    );

    /**
     * Report status of generic I/O interface
     */
    void ReportInputOutputStatus
    (
      /// Status of the generic I/O interface
      in InputOutputStatus Status,

      /// Indicates whether the status is no longer present
      in boolean IsRemoved
    );

    /**
     * Report value of a register
     */
    void ReportRegister
    (
      /// Identifier of the register
      in string KeyId,

      /// Value of the register
      in M_Common::PropertyType Value,

      /// Indicates whether the register value is removed
      in boolean IsRemoved
    );

    /**
     * Report all active errors
     */
    void ReportActiveErrors
    (
      /// List of all active errors
      in M_Common::StringListType ActiveErrors,

      /// Indicates whether the errors are removed
      /// Note: If true, the errors are no longer present.
      in boolean IsRemoved
    );

    /**
     * Event of read data by the interface service
     */
    void EventDataReceived
    (
      /// Data read by the I/O interface
      in InputOutputData Data
    );
  };
};
