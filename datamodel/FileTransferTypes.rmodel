#include "CommonTypes.rmodel"


/**
 * Interfaces and types used by the FileTransfer Service and Client.
 */
module M_FileTransfer
{
  module TransferStatusKind
  {
    /// The enumeration for the transfer status.
    enum Type
    {
      /// The transfer status is not known.
      Unknown,

      /// The transfer is in progress.
      In_Progress,

      /// The transfer is queued and waiting for execution.
      Waiting,

      /// The transfer is paused.
      Paused,

      /// The transfer is failed.
      Failed
    };
  };

  struct FileTransferInfoType
  {
      /// The source file url.
      string SourceFileUrl;

      /// The target url.
      string TargetFileUrl;

      /// Optional: Transfer file from this offset.
      M_Common::ULongLongOptionalType Offset;

      /// Optional: Transfer from offset to this given size.
      M_Common::ULongLongOptionalType Size;

      /// Optional: The encryption info - if decryption is necessary.
      M_Common::EncryptionOptionalType EncryptionInfo;

      /// Optional: Additional information.
      M_Common::PropertyListType AdditionalInfo;
  };

  typedef sequence<FileTransferInfoType, 1> FileTransferInfoOptionalType;

  /// Contains current status data for the FileTransfer Service.
  struct FileTransferStatusType
  {
    /// The current status of the file transfer.
    TransferStatusKind::Type TransferStatus;

    /// A textual description about the status.
    /// This can be a error description or any other important information about the status.
    string TransferStatusDescription;

    /// Optional: The current transfered bytes.
    M_Common::ULongLongOptionalType CurrentBytes;

    /// Optional: The total bytes to be transfered.
    M_Common::ULongLongOptionalType TotalBytes;
  };
};
