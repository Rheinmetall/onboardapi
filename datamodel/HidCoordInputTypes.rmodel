/**
 * Types used by the Coord Input Service.
 */
module M_HidCoordInput
{
  /**
   * Contains settings for Coord Input Service.
   */
  struct CoordInputSettingsType
  {
    /// Indicates if the Service supports reporting the cursor position (true) or not (false).
    boolean IsCursorPositionSupported;
    /// Indicates if the Service generates click events when input is generated (true) or not (false).
    boolean IsClickSupported;
  };
};
